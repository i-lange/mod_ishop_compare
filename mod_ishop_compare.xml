<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>mod_ishop_compare</name>
    <author>Pavel Lange</author>
    <creationDate>2025-12-13</creationDate>
    <copyright>(C) 2025 Pavel Lange &lt;https://ilange.ru&gt;</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>pavel@ilange.ru</authorEmail>
    <authorUrl>https://ilange.ru/en/contact</authorUrl>
    <version>1.0.0</version>
    <description>MOD_ISHOP_COMPARE_XML_DESCRIPTION</description>
    <scriptfile>script.php</scriptfile>
    <namespace path="src">Ilange\Module\Ishopcompare</namespace>

    <files>
        <folder module="mod_ishop_compare">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <languages>
        <language tag="en-GB">language/en-GB/mod_ishop_compare.ini</language>
        <language tag="en-GB">language/en-GB/mod_ishop_compare.sys.ini</language>
        <language tag="ru-RU">language/ru-RU/mod_ishop_compare.ini</language>
        <language tag="ru-RU">language/ru-RU/mod_ishop_compare.sys.ini</language>
    </languages>

    <media destination="mod_ishop_compare" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>css</folder>
        <folder>js</folder>
    </media>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="show_text"
                       type="radio"
                       buttons="true"
                       layout="joomla.form.field.radio.switcher"
                       default="1"
                       label="MOD_ISHOP_COMPARE_XML_SHOW_TEXT">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="show_count"
                       type="radio"
                       buttons="true"
                       layout="joomla.form.field.radio.switcher"
                       default="1"
                       label="MOD_ISHOP_COMPARE_XML_SHOW_COUNT">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="show_btn_clear"
                       type="radio"
                       buttons="true"
                       layout="joomla.form.field.radio.switcher"
                       default="1"
                       label="MOD_ISHOP_COMPARE_XML_SHOW_BTN_CLEAR">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
            <fieldset name="advanced">
                <field name="use_css"
                       type="radio"
                       buttons="true"
                       layout="joomla.form.field.radio.switcher"
                       default="1"
                       label="MOD_ISHOP_COMPARE_XML_USE_CSS"
                       description="MOD_ISHOP_COMPARE_XML_USE_CSS_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="use_js"
                       type="radio"
                       buttons="true"
                       layout="joomla.form.field.radio.switcher"
                       default="1"
                       label="MOD_ISHOP_COMPARE_XML_USE_JS"
                       description="MOD_ISHOP_COMPARE_XML_USE_JS_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="layout"
                       type="modulelayout"
                       label="JFIELD_ALT_LAYOUT_LABEL"
                       class="form-select"
                       validate="moduleLayout"/>
            </fieldset>
        </fields>
    </config>

    <changelogurl>https://update.ilange.ru/mod_ishop_compare/changelog.xml</changelogurl>
    <updateservers>
        <server type="extension" priority="1" name="mod_ishop_compare">https://update.ilange.ru/mod_ishop_compare/updates.xml</server>
    </updateservers>
</extension>